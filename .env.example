# ==============================================================================
# Portfolio Application Environment Configuration (.env.example)
#
# IMPORTANT:
# 1. Copy this file to .env.local for local development.
# 2. Never commit actual secret keys or API credentials to version control.
# 3. Configure all variables in Vercel Project Settings for production.
# ==============================================================================

# ─── Public Environment Variables (Client & Server) ───────────────────────────
# Canonical base URL of your portfolio deployment
NEXT_PUBLIC_SITE_URL=https://your-portfolio.vercel.app

# Supabase Project URL & Anon Public Key (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloudinary Cloud Name (for public image CDN optimization)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# ─── Server-Only Private Variables (NEVER expose to Client JS) ────────────────
# Authorized Owner Admin Email (Must match the email used to login at /admin)
ADMIN_EMAIL=admin@example.com

# Supabase Service Role Key (Server-only for admin operations bypassing RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloudinary Server Credentials (for secure admin upload & delete server actions)
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OpenRouter AI Assistant API Key (Optional — fallback knowledgebase activates if empty)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
